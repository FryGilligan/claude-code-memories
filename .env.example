# claude-code-memories root env — copy to .env and chmod 600.
# Only ANTHROPIC_API_KEY is required for the extractor.
# The bot reads its own env file at bot/bot.env (see bot/bot.env.example).

ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the location of the Anthropic env file the extractor reads.
# By default it reads ~/.config/anthropic/.env. If you prefer to keep the key
# in this repo's .env, set:
#   ANTHROPIC_ENV=/absolute/path/to/this/repo/.env

# Optional: override the path used as the repo root by extract_memory.py
# and the bot. Defaults to the script's parent dir, which is correct when
# you run from a clone.
# MEMORIES_REPO=/absolute/path/to/this/repo

# Optional: override Claude Code's session JSONL location. By default the
# extractor uses ~/.claude/projects/<sanitised-cwd>/. Set this only if your
# sessions aren't under the default.
# CLAUDE_PROJECTS_DIR=/home/youruser/.claude/projects/-home-youruser
