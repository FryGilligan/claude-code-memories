# claude-code-memories Discord bot — copy to bot.env and fill in. chmod 600.

# ── required ──────────────────────────────────────────────────────────────
# Discord Developer Portal → your bot application → Bot → Reset Token
DISCORD_BOT_TOKEN=

# Right-click the review channel → Copy Channel ID (Developer Mode on first).
CHANNEL_ID=

# Right-click your own username → Copy User ID.
# Only this user's reactions trigger publish/reject.
OWNER_USER_ID=

# ── optional, with sensible defaults ──────────────────────────────────────
# Path to the cloned claude-code-memories repo. Defaults to the parent of bot/.
# MEMORIES_REPO=/path/to/claude-code-memories

# Bot state + log files. Default: alongside the bot scripts.
# STATE_FILE=/path/to/claude-code-memories/bot/state.json
# LOG_FILE=/path/to/claude-code-memories/bot/bot.log

# Discord guild ID — enables deep-link URLs in the weekly briefing embed.
# DISCORD_GUILD_ID=

# Where Claude Code stores session JSONLs. Override only if your sessions
# aren't under the default location for your $HOME.
# CLAUDE_PROJECTS_DIR=/home/youruser/.claude/projects/-home-youruser

# When true, drafts with duration_mins < 1 AND no tools_produced are skipped.
SKIP_TRIVIAL=false

# When true, IPs are stripped from the embed text before posting.
# Memory file on disk + site stays untouched — scrub is embed-only.
SCRUB_EMBEDS=true

# Comma-separated host suffixes to also strip from embeds when SCRUB_EMBEDS is true.
# Useful if you have an internal hostname you don't want appearing in Discord previews.
# SCRUB_HOST_SUFFIXES=example.com,internal.lan
